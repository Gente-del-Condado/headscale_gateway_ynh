* text=auto
*.go text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.js text eol=lf
*.cjs text eol=lf
packaging/yunohost/scripts/* text eol=lf
yunohost/scripts/* text eol=lf
yunohost/payload/headscale-gateway-linux-* binary
*.cmd text eol=crlf
*.png binary
*.zip binary
*.gz binary
# Generated install trees must keep the exact checksummed build bytes.
addons/** -text
yunohost/** -text

# Los avisos y fuentes incorporados de terceros conservan sus bytes originales.
src/third_party/** -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
src/internal/acmednstechnitium/** -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
addons/headscale_gateway/notices/** -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
yunohost/doc/third_party/** -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
