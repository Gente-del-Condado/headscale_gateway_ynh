#!/usr/bin/python3
"""Primera configuración explícita; una actualización nunca la sobrescribe."""
import argparse
from getpass import getpass
from pathlib import Path
import sys
sys.path.insert(0, '/usr/libexec/headscale-gateway')
from hgw_bootstrap import prepare

def main(argv=None, data=Path('/var/lib/headscale-gateway')):
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument('--admin', required=True, help='Usuario que utilizarás para entrar en el panel web')
    p.add_argument('--listen', default='127.0.0.1:9091')
    a = p.parse_args(argv)
    if (data/'config/startup.json').exists() or (data/'gateway/gateway.sqlite').exists():
        p.error('Ya existe una instalación: utiliza el panel o la recuperación; no se sobrescribe su configuración.')
    print('Cuenta del panel de Headscale Gateway: ' + a.admin.strip())
    print('Ahora crearás su contraseña. Es distinta de la contraseña que sudo pide para tu cuenta de Linux.')
    password = getpass('Nueva contraseña del panel (12–72 bytes): ')
    if password != getpass('Repite la contraseña: '):
        p.error('Las contraseñas no coinciden')
    prepare(data, data/'config', a.listen, username=a.admin, password=password)
    print('\nConfiguración preparada. No es necesario volver a ejecutar este configurador.')
    print('1. Inicia el servicio: sudo systemctl enable --now headscale-gateway')
    print('2. Abre el panel: http://' + a.listen + '/admin/')
    print('3. Usuario del panel: ' + a.admin.strip())
    print('   Contraseña: la nueva contraseña del panel que acabas de crear; no la de sudo.')
    print('También puedes abrir Headscale Gateway desde el menú de aplicaciones.')

if __name__ == '__main__':
    main()
